# ==============================================================================
# DentaMaroc — Open-Source Dental Practice Management Configuration
# Copy this file to `.env` to customize your instance:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Branding & Demo Controls
# ------------------------------------------------------------------------------
VITE_APP_NAME="DentaMaroc"
VITE_APP_TAGLINE="Logiciel Médical & Gestion de Cabinet Dentaire"
VITE_APP_VERSION="0.2.0"

# Enable pre-populated fictitious demo data (set to "false" in production)
VITE_DEMO_MODE="true"

# Show the 1-click top-bar RBAC Role Switcher (Dentiste / Assistante / Secrétaire)
VITE_ENABLE_ROLE_SWITCHER="true"

# ------------------------------------------------------------------------------
# 2. Regional, Currency & Healthcare Regulatory Settings
# Easily adapt for Morocco (MAD/+212), Tunisia (TND/+216), France (EUR/+33), etc.
# ------------------------------------------------------------------------------
VITE_DEFAULT_CURRENCY="MAD"
VITE_DEFAULT_LOCALE="fr-MA"
VITE_TIMEZONE="Africa/Casablanca"
VITE_COUNTRY_DIAL_CODE="212"
VITE_DEFAULT_CITY="Casablanca"
VITE_REGULATORY_AUTHORITY="CNDP"
VITE_REGULATORY_LAW="Loi 09-08"

# ------------------------------------------------------------------------------
# 3. Firebase Backend & Emulator Suite
# Leave VITE_USE_EMULATORS="true" for zero-config local development
# ------------------------------------------------------------------------------
VITE_USE_EMULATORS="true"
VITE_FIREBASE_REGION="europe-west9"
VITE_FIREBASE_API_KEY="your_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="dentamaroc-prod.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="dentamaroc-prod"
VITE_FIREBASE_STORAGE_BUCKET="dentamaroc-prod.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
